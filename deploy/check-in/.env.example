# Copy to /root/metapi-checkin-deploy/.env and fill secrets.
AUTH_TOKEN=replace-with-a-long-admin-password
PROXY_TOKEN=replace-with-a-long-proxy-token
ACCOUNT_CREDENTIAL_SECRET=replace-with-a-long-random-secret
CHECKIN_PORT=14000
CHECKIN_DATA_DIR=/root/metapi-checkin-deploy/data
CHECKIN_APP_MODE=true
CHECKIN_CRON=0 9 * * *
CHECKIN_SCHEDULE_MODE=cron
CHECKIN_INTERVAL_HOURS=6
BALANCE_REFRESH_CRON=0 * * * *
TZ=Asia/Shanghai
# Optional egress settings:
# RESIN_STICKY_PROXY_ENDPOINTS=proxy.internal:10834
# RESIN_EGRESS_GATEWAY_URL=http://resin-egress-gateway:8080
