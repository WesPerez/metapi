# Meta API Hub - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Admin authentication token (required, change this!)
AUTH_TOKEN=change-me-admin-token

# Proxy API token used for OpenAI-compatible proxy endpoint (required, change this!)
PROXY_TOKEN=change-me-proxy-sk-token
PORT=4000
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Resin sticky-egress recovery. Mount the token file into the
# container before setting RESIN_EGRESS_GUARD_TOKEN_FILE.
RESIN_STICKY_PROXY_ENDPOINTS=
RESIN_EGRESS_GUARD_URL=
RESIN_EGRESS_GUARD_TOKEN_FILE=
RESIN_EGRESS_GUARD_TIMEOUT_MS=1500
RESIN_EGRESS_CONNECT_TIMEOUT_MS=10000
RESIN_EGRESS_TLS_HANDSHAKE_TIMEOUT_MS=10000
RESIN_EGRESS_RESPONSE_HEADER_TIMEOUT_MS=120000
PROXY_FIRST_BYTE_TIMEOUT_SEC=0

# Auto check-in cron (default: 8:00 AM every day)
CHECKIN_CRON=0 8 * * *

# Balance refresh cron (default: every hour)
BALANCE_REFRESH_CRON=0 * * * *
